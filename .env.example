# Leave empty for offline mock mode. Set a real key + MOCK_LLM=false for live LLM calls.
OPENAI_API_KEY=

# Optional overrides
OPENAI_MODEL=gpt-4o
MAX_RETRIES=3
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_IMAGE=self-healing-sandbox:latest
MOCK_LLM=true
# When true, run pytest on the host instead of Docker (dev / Docker-unavailable fallback)
ALLOW_LOCAL_SANDBOX=true
HOST=0.0.0.0
PORT=43127
