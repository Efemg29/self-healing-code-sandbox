# Required for live LLM calls (omit or set MOCK_LLM=true to use offline mock mode)
OPENAI_API_KEY=sk-your-key-here

# Optional overrides
OPENAI_MODEL=gpt-4o
MAX_RETRIES=3
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_IMAGE=self-healing-sandbox:latest
MOCK_LLM=false
# When true, run pytest on the host instead of Docker (dev / Docker-unavailable fallback)
ALLOW_LOCAL_SANDBOX=true
HOST=0.0.0.0
PORT=43127
